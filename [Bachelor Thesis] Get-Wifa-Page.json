    {
      "parameters": {
        "jsCode": "const html = $input.first().json.data || '';\n\nfunction extractMain(html) {\n  const mainStart = html.search(/<main\\b[^>]*id=[\"']content[\"'][^>]*>/i);\n  if (mainStart >= 0) {\n    const afterStart = html.slice(mainStart);\n    const mainEndRel = afterStart.search(/<\\/main>/i);\n    if (mainEndRel >= 0) {\n      return afterStart.slice(0, mainEndRel + 7);\n    }\n    return afterStart;\n  }\n  return html;\n}\n\nfunction removeBlocks(str, patterns) {\n  let out = str;\n  for (const pattern of patterns) {\n    out = out.replace(pattern, '');\n  }\n  return out;\n}\n\nlet cleaned = extractMain(html);\n\n// Offensichtliche Störbereiche innerhalb <main>\ncleaned = removeBlocks(cleaned, [\n  /<nav\\b[^>]*aria-label=[\"']Breadcrumb[\"'][\\s\\S]*?<\\/nav>/gi,\n  /<a\\b[^>]*class=[\"'][^\"']*\\bback\\b[^\"']*[\"'][\\s\\S]*?<\\/a>/gi,\n  /<ul\\b[^>]*class=[\"'][^\"']*\\blist-timeline\\b[^\"']*[\"'][\\s\\S]*?<\\/ul>/gi,\n  /<aside\\b[\\s\\S]*?<\\/aside>/gi,\n  /<section\\b[^>]*id=[\"']c402236[\"'][\\s\\S]*?<\\/section>/gi, // \"Das könnte Sie auch interessieren\"\n  /<div\\b[^>]*class=[\"'][^\"']*\\bflashCards\\b[^\"']*[\"'][\\s\\S]*?<\\/div>\\s*<\\/div>/gi, // Download-Karten grob\n  /<figure\\b[\\s\\S]*?<\\/figure>/gi,\n  /<script\\b[\\s\\S]*?<\\/script>/gi,\n  /<style\\b[\\s\\S]*?<\\/style>/gi,\n  /<noscript\\b[\\s\\S]*?<\\/noscript>/gi,\n]);\n\n// Akkordeon-Links entschärfen: Frageüberschrift behalten, Technik-Attribute weg\ncleaned = cleaned\n  .replace(/\\s(?:aria-controls|aria-expanded|data-parent|data-toggle|role|target|rel|title)=[\"'][^\"']*[\"']/gi, '')\n  .replace(/\\s(?:class|style|id)=[\"'][^\"']*[\"']/gi, '');\n\n// Links mit rein internen collapse-/anchor-Zielen zu normalem Text machen\ncleaned = cleaned.replace(\n  /<a\\b[^>]*href=[\"']#(?:collapse|c)[^\"']*[\"'][^>]*>([\\s\\S]*?)<\\/a>/gi,\n  '$1'\n);\n\n// Leere/unnötige Wrapper etwas glätten\ncleaned = cleaned\n  .replace(/>\\s+</g, '><')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\n\nreturn [\n  {\n    json: {\n      cleanedHtml: cleaned\n    }\n  }\n];"
      },
